      "id": "ureteral-access-sheath",
      "categoryId": "endourology",
      "type": "Access",
      "name": "Ureteral access sheath",
      "description": "Maintains a working channel to the upper tract during ureteroscopy and RIRS.",
      "image": {
        "key": null,
        "alt": "Ureteral access sheath"
      },
      "title": "Ureteral Access",
      "titleAccent": "Sheath",
      "tagline": "A ureteral access sheath that holds a working channel to the upper tract, so the ureteroscope can pass in and out through the procedure.",
      "keyBenefits": [
        "Stable working channel through ureteroscopy and RIRS",
        "Supports repeated scope passes",
        "Range of sizes to suit the ureter"
      ],
      "sizes": [
        "Size 1",
        "Size 2",
        "Size 3",
        "Size 4"
      ],
      "brochure": null,
      "overview": {
        "eyebrow": "Product overview",
        "title": "A steady channel for every scope pass.",
        "paragraphs": [
          "The ureteral access sheath is placed over a guidewire to give the ureteroscope a fixed route to the kidney. It keeps the channel open while the scope is passed in and out, and allows irrigation to drain during the procedure."
        ],
